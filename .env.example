#==========================================================================
# server-deploy-toolkit 配置文件
# 复制为 .env 后修改：cp .env.example .env
#==========================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=Root@2026
MYSQL_PASSWORD=App@2026
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- 备份 ----
BACKUP_DIR=/var/backups/mysql
RETENTION_DAYS=7
DB_NAMES=--all-databases

# ---- 部署 ----
DEPLOY_DIR=/var/www
DEPLOY_BACKUP_DIR=/var/backups/deploy

# ---- 告警 Webhook（留空则不发送） ----
DINGTALK_WEBHOOK=
WECOM_WEBHOOK=

# ---- 日志分析 ----
LOG_ANALYZE_HOURS=1
LOG_TOP_N=10
